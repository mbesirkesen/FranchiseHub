DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/franchisehub
SECRET_KEY=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFY_EXPIRE_MINUTES=1440
# Dev only: return reset_token in forgot-password response
EXPOSE_AUTH_TOKENS_IN_RESPONSE=false
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
UPLOAD_ROOT=uploads
MAX_UPLOAD_BYTES=10485760
DOWNLOAD_TOKEN_EXPIRE_MINUTES=15

# Franchise asistanı (chatbot)
AGENT_RATE_LIMIT_PER_MINUTE=30
AGENT_SESSION_MAX_MESSAGES=100
AGENT_CONTEXT_MESSAGE_LIMIT=8
AGENT_LLM_ENABLED=true
# Groq: https://console.groq.com/keys
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
